# Copy to .env and adjust. Never commit .env.
APP_ENV=development
PORT=8080

# Match your local PostgreSQL instance.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fitfueler?sslmode=disable

# At least 32 characters. Generate one with the command in the README.
JWT_SECRET=
JWT_ISSUER=fit-fueler-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Comma-separated OAuth client IDs accepted as the "aud" of Google ID tokens.
# Use the WEB client ID (the one the app passes as webClientId). Required in production.
GOOGLE_CLIENT_IDS=

APPLE_SIGN_IN_ENABLED=false

# Both default to true in development and false in production.
DEV_LOGIN_ENABLED=true
SWAGGER_ENABLED=true

# Check the DiceBear docs for the current version in this URL.
AVATAR_BASE_URL=https://api.dicebear.com/10.x/adventurer/svg

AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW=1m
